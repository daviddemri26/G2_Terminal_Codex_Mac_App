{
  "name": "g2-desktop-bridge",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "A local bridge between Even Terminal and the existing Codex Mac task engine.",
  "engines": { "node": "26.9.0" },
  "scripts": {
    "build": "python3 scripts/build-runtime.py",
    "test": "node --test bridge/*.test.mjs client-contract/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:operations": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s operations -p 'test_*.py' -v",
    "test:build": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests/build -p 'test_*.py' -v",
    "check": "npm run build && npm test && npm run test:integration && npm run test:operations && npm run test:build"
  },
  "dependencies": { "@evenrealities/even-terminal": "0.10.4", "yargs": "18.1.0" },
  "overrides": { "yargs": "18.1.0" }
}
